PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=workshop_job_tracker

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=8h

NODE_ENV=development
LOG_LEVEL=info
# PUBLIC REGISTRATION DISABLED by default. Set true temporarily ONLY for first admin on an empty DB.
ALLOW_INITIAL_ADMIN_REGISTRATION=false
# For browser access, set to your deployed frontend domain in production.
FRONTEND_ORIGIN=http://localhost:5173
